
{
  "entities": {
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a single takjil item.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "sku": { "type": "string" },
        "vendor": { "type": "string" },
        "stock": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "sku", "vendor"]
    },
    "Vendor": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vendor",
      "type": "object",
      "description": "Represents a partner UMKM.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "code"]
    },
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Stores customer profile and contact details.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "lastOrderAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phoneNumber", "deliveryAddress"]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Represents a customer order.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "orderDateTime": { "type": "string", "format": "date-time" },
        "deliveryDate": { "type": "string", "format": "date-time" },
        "paymentMethod": { "type": "string", "enum": ["QRIS", "COD"] },
        "deliveryFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "vendorStatuses": { "type": "object" },
        "deliveryAddress": { "type": "string" }
      },
      "required": ["id", "customerId", "orderDateTime", "paymentMethod", "totalAmount"]
    },
    "OrderItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "OrderItem",
      "type": "object",
      "description": "Represents an item within an order.",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "customerId": { "type": "string" },
        "menuItemId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "vendor": { "type": "string" },
        "quantity": { "type": "number" },
        "priceAtOrder": { "type": "number" }
      },
      "required": ["id", "orderId", "menuItemId", "quantity", "priceAtOrder"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/menuItems/{itemId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Stores takjil menu items."
    },
    "/vendors/{vendorId}": {
      "schema": { "$ref": "#/backend/entities/Vendor" },
      "description": "Stores UMKM partner details."
    },
    "/customers/{userId}": {
      "schema": { "$ref": "#/backend/entities/Customer" },
      "description": "Customer profiles."
    },
    "/customers/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/backend/entities/Order" },
      "description": "Customer orders."
    },
    "/customers/{userId}/orders/{orderId}/orderItems/{orderItemId}": {
      "schema": { "$ref": "#/backend/entities/OrderItem" },
      "description": "Items in each order."
    }
  }
}
