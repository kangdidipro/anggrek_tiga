
{
  "entities": {
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Stores information about a customer who places an order.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Customer entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the customer as provided in the order form."
        },
        "email": {
          "type": "string",
          "description": "The email address of the customer.",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string",
          "description": "The contact phone number or WhatsApp number of the customer."
        },
        "deliveryAddress": {
          "type": "string",
          "description": "The full delivery address where the order should be sent."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "phoneNumber",
        "deliveryAddress"
      ]
    },
    "MenuItemGroup": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItemGroup",
      "type": "object",
      "description": "Represents a high-level grouping for menu item categories (e.g., 'Makanan Utama', 'Minuman').",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the group."
        },
        "name": {
          "type": "string",
          "description": "Name of the group."
        },
        "description": {
          "type": "string",
          "description": "Description of what kind of items belong here."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "MenuItemCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItemCategory",
      "type": "object",
      "description": "Represents a category for organizing menu items (e.g., 'Nasi', 'Bakso', 'Kue').",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the MenuItemCategory entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the menu item category."
        },
        "groupId": {
          "type": "string",
          "description": "Reference to MenuItemGroup."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "MenuItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItem",
      "type": "object",
      "description": "Represents a single food or takjil item available on the menu.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the MenuItem entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the food item."
        },
        "description": {
          "type": "string",
          "description": "A brief description."
        },
        "price": {
          "type": "number",
          "description": "The price."
        },
        "category": {
          "type": "string",
          "description": "The category name (denormalized)."
        },
        "vendor": {
          "type": "string",
          "description": "The vendor code."
        },
        "stock": {
          "type": "number",
          "description": "Available stock."
        }
      },
      "required": [
        "id",
        "name",
        "price",
        "category",
        "vendor"
      ]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Represents a complete customer order.",
      "properties": {
        "id": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "orderDateTime": {
          "type": "string",
          "format": "date-time"
        },
        "totalAmount": {
          "type": "number"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "customerId",
        "orderDateTime",
        "totalAmount",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/menuItemGroups/{groupId}",
        "definition": {
          "entityName": "MenuItemGroup",
          "schema": {
            "$ref": "#/backend/entities/MenuItemGroup"
          },
          "description": "Collection for top-level menu groups (Makanan, Minuman, Snack)."
        }
      },
      {
        "path": "/categories/{categoryId}",
        "definition": {
          "entityName": "MenuItemCategory",
          "schema": {
            "$ref": "#/backend/entities/MenuItemCategory"
          },
          "description": "Master collection for menu categories."
        }
      },
      {
        "path": "/menuItems/{menuItemId}",
        "definition": {
          "entityName": "MenuItem",
          "schema": {
            "$ref": "#/backend/entities/MenuItem"
          },
          "description": "Collection for all individual takjil items."
        }
      },
      {
        "path": "/customers/{userId}",
        "definition": {
          "entityName": "Customer",
          "schema": {
            "$ref": "#/backend/entities/Customer"
          },
          "description": "Public customer profile collection."
        }
      },
      {
        "path": "/settings/{settingId}",
        "definition": {
          "entityName": "Setting",
          "schema": {
            "type": "object"
          },
          "description": "System settings like inventory params and mail config."
        }
      }
    ],
    "reasoning": "The structure maintains clear separation between master data (Groups, Categories, Items) which are mostly public read, and transactional data (Orders) which are private to owners or admins. System settings are split into public (inventory) and private (mail) documents via rules."
  }
}
