rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * APPLICATION SECURITY FILOSOPHY:
     * 1. Ownership Model: Most data (Customers, Orders, OrderItems) is strictly partitioned by the user's UID.
     * 2. Public Catalog: Products and Vendors are publicly readable to allow all users to browse.
     * 3. Admin Override: A dedicated /admin_roles collection identifies users with elevated privileges.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    // Helper to ensure the document exists and the requester owns it
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Publicly readable catalog of takjil items.
     * @path /menuItems/{itemId}
     */
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly readable list of vendors/partners.
     * @path /vendors/{vendorId}
     */
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Customer profile documents.
     * @path /customers/{userId}
     */
    match /customers/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Orders placed by customers.
     * @path /customers/{userId}/orders/{orderId}
     */
    match /customers/{userId}/orders/{orderId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.customerId == userId;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Items within an order.
     * @path /customers/{userId}/orders/{orderId}/orderItems/{orderItemId}
     */
    match /customers/{userId}/orders/{orderId}/orderItems/{orderItemId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.orderId == orderId;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description System settings (Mail, Inventory).
     * @path /settings/{settingId}
     */
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Administrative roles.
     * @path /admin_roles/{uid}
     */
    match /admin_roles/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}