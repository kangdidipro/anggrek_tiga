
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocumentOwner(ownerIdField) {
      return isSignedIn() && request.auth.uid == ownerIdField;
    }

    // --- Collection Rules ---

    match /admin_users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /menuItemGroups/{groupId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /menuItems/{menuItemId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /customers/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Sub-collections under customers
    match /customers/{userId}/orders/{orderId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{userId}/orders/{orderId}/orderItems/{itemId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    // Root collection group access for Admin
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }
    match /{path=**}/orderItems/{itemId} {
      allow read: if isAdmin();
    }

    // Settings rules
    match /settings/inventory {
      allow get: if true;
      allow write: if isAdmin();
    }
    
    match /settings/mail {
      allow get, write: if isAdmin();
    }
    
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
