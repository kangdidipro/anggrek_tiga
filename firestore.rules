
/**
 * # Firestore Security Rules: Ramadhan Takjil Order App
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Aturan untuk pencarian lintas koleksi (Collection Group)
    match /{path=**}/orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /{path=**}/orderItems/{orderItemId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow get: if isOwner(customerId);
      allow list: if false; 
      
      allow create: if isOwner(customerId)
                       && request.resource.data.id == customerId
                       && request.resource.data.googleAccountId == customerId;
      
      allow update: if isOwner(customerId)
                       && request.resource.data.id == resource.data.id
                       && request.resource.data.googleAccountId == resource.data.googleAccountId;
      
      allow delete: if isOwner(customerId);

      match /orders/{orderId} {
        allow write: if isOwner(customerId) || isSignedIn();

        match /orderItems/{orderItemId} {
          allow write: if isOwner(customerId) || isSignedIn();
        }
      }
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if isSignedIn(); 
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      // Izinkan akses baca/tulis untuk semua pengguna yang login (termasuk anonim)
      // Dibutuhkan untuk membaca konfigurasi SMTP saat pengiriman struk email
      allow read, write: if isSignedIn();
    }
  }
}
